#!/usr/bin/env bqn
# The book from the command line, in tab-separated lines that any screen (a TUI, a
# GUI, a script) can write and read. The screens stay outside; this is their door.
#
#   book <book.txt> balances   one line per Locus × Measure: Locus, Measure, amount or ?
#   book <book.txt> preview    change lines on stdin (bakhlo's change language)
#                              → OK and the lines the change adds, or REFUSED <code>
#   book <book.txt> save       the same, then saves: SAVED and the lines, or REFUSED <code>
#   book <book.txt> ask        questions on stdin (PACE, PAST, ACTIVITY with POOL lines,
#                              as bakhlo's samples write them) → each with its answer
#   book <book.txt> measures   id, decimal places
#   book <book.txt> loci       id, label, help, HIDDEN or "", role or ""
#   book <book.txt> entries    id, day, memo, merchant (name, NONMERCHANT, "" if
#                              unclassified), the TX it reverses, the plan it pays
#   book <book.txt> plans      id, due day, Measure, open|paid|cancelled, its TX or day, amount
#   book <book.txt> entry <id> the entry as a change that would keep it: edit, then save
#   book <book.txt> plan <id>  the same for a plan
#   book <book.txt> open ENTRY|PLAN <id>
#                              the entry or open plan as a form: MEASURE, ROW key|- account ±amount
#   book <book.txt> form NEW - | EDIT <id> | PAY <plan>
#                              form lines on stdin (DAY, MEMO, MEASURE, ROW key|- account
#                              ±amount, ORIGINAL m quanta; a memo as typed, an amount may be
#                              an expression) → the change that records it, or REFUSED <code>
#   book <book.txt> refund <id> <day>
#                              the change that refunds the entry
#   book <book.txt> pool       the accounts today's guide spends from (bk's daily-pace.tsv)
#   book <book.txt> view       the balances bk shows (balance-view.tsv): account, Measure
#   book <book.txt> cycle <day>
#                              the cycle holding day: name, start, end (bk's
#                              boundary-presets.tsv; end excluded)
# bk's settings are read from config/ next to the book, or else next to it.
#
# Text in a row is written as in book.txt (\t, \n, \\ escaped), and so is a memo in a change.
#
# Amounts are integers in the Measure's smallest unit. Exit status: 0 done, 1 refused.
store ← •Import "../src/store.bqn"
change ← •Import "../src/change.bqn"
balance ← •Import "../src/balance.bqn"
pace ← •Import "../src/pace.bqn"
form ← •Import "../src/form.bqn"
config ← •Import "../src/config.bqn"
view ← •Import "../src/view.bqn"
tab ← @+9
Row ← {1↓∾(tab∾⊢)¨𝕩}
Int ← {𝕩<0 ? "-"∾𝕊-𝕩 ; 𝕩<10 ? ⋈'0'+𝕩 ; (𝕊⌊𝕩÷10)∾'0'+10|𝕩}
Out ← {•Out¨𝕩 ⋄ •Exit 0}
Refused ← {•Out "REFUSED"∾tab∾𝕩.code ⋄ •Exit 1}
# lines the new text has and the old one has not: a change only inserts, so each
# line's occurrence count tells an added copy from an old one
Added ← {new 𝕊 old: (¬(new⋈¨⊒new)∊old⋈¨⊒old)/new}

path‿command‿id‿extra ← 4↑•args∾3⥊<""
loaded ← store.Load •wdpath •file.At path
Refused⍟(¬loaded.ok) loaded

Balances ← {𝕊:
  b ← loaded.book
  asked ← ⥊b.locus.id ⋈⌜ b.measure.id
  Out asked {Row 𝕨∾⟨(@≡𝕩)◶⟨Int,"?"˙⟩ 𝕩⟩}¨ b balance.Balances asked
}
Changed ← {𝕊: c ← loaded change.Apply •FLines "/dev/stdin" ⋄ Refused⍟(¬c.ok) c}
Preview ← {𝕊: Out ⟨"OK"⟩ ∾ (Changed @).lines Added loaded.lines}
Save ← {𝕊: s ← loaded store.Save Changed @ ⋄ Refused⍟(¬s.ok) s ⋄ Out ⟨"SAVED"⟩ ∾ s.lines Added loaded.lines}
Ask ← {𝕊:
  lines ← •FLines "/dev/stdin"
  heads ← ({(⊑𝕩⊐tab)↑𝕩}¨lines)∊"PACE"‿"PAST"‿"ACTIVITY"     # each question starts a group
  Out ∾ (loaded.book pace.Ask ⊢)¨ (¯1++`heads)⊔lines
}
Listed ← {Out Row¨ 𝕏 loaded.book}
Edited ← {r ← loaded change.Edit 𝕩‿id ⋄ (6=•Type r)◶⟨Out, Refused⟩ r}
# lines, or a refusal
Answer ← {(6=•Type 𝕩)◶⟨Out, Refused⟩ 𝕩}
# a new entry's ID, as bakhlo makes them: entry- and 24 hex digits
NewId ← {𝕊: "entry-"∾"0123456789abcdef"⊏˜24 •rand.Range 16}
Opened ← {𝕊: Answer loaded.book form.Open id‿extra}
Filled ← {𝕊:
  target‿newId ← ("EDIT"≡id)◶⟨extra‿(NewId @), extra‿""⟩ @
  Answer loaded form.Fill id‿(("NEW"≡id)⊑target‿"-")‿newId‿(•FLines "/dev/stdin")
}
Refunded ← {𝕊: r ← loaded form.Refund id‿extra‿(NewId @) ⋄ Answer (6=•Type r)◶⟨⟨"PUT-ENTRY"∾tab∾"NEW"∾tab∾"-"⟩⊸∾, ⊢⟩ r}
# bk's settings file, from config/ next to the book or else next to it; @ if neither
Setting ← {
  dir ← •file.Parent loaded.path
  at ← (•file.Exists¨)⊸/ (dir∾"/config/"∾𝕩)‿(dir∾"/"∾𝕩)
  (0<≠at)◶⟨@˙, {𝕊: •FChars ⊑at}⟩ @
}
Pooled ← {𝕊: r ← (⊑loaded.book.measure.id) config.Pool Setting "daily-pace.tsv" ⋄ (6=•Type r)◶⟨Out, Refused⟩ r}
Viewed ← {𝕊: r ← config.View Setting "balance-view.tsv" ⋄ (6=•Type r)◶⟨Out∘(Row¨), Refused⟩ r}
Cycled ← {𝕊: r ← (Setting "boundary-presets.tsv") config.Cycle id ⋄ r.ok◶⟨Refused, Out∘{⟨Row 𝕩.name‿𝕩.start‿𝕩.end⟩}⟩ r}
Usage ← {𝕊: •Out "usage: book <book.txt> balances|preview|save|ask|measures|loci|entries|plans|entry <id>|plan <id>|open ENTRY|PLAN <id>|form NEW - | EDIT <id> | PAY <plan>|refund <id> <day>" ⋄ •Exit 2}
commands ← "balances"‿"preview"‿"save"‿"ask"‿"measures"‿"loci"‿"entries"‿"plans"‿"entry"‿"plan"‿"open"‿"form"‿"refund"‿"pool"‿"cycle"‿"view"
(⊑commands⊐<command)◶⟨
  Balances, Preview, Save, Ask
  {𝕊: Listed view.measures}, {𝕊: Listed view.loci}, {𝕊: Listed view.entries}, {𝕊: Listed view.plans}   # as values
  {𝕊: Edited "TX"}, {𝕊: Edited "PLAN"}
  Opened, Filled, Refunded
  Pooled, Cycled, Viewed
  Usage
⟩ @
