#!/usr/bin/env bqn
# The book from the command line, in tab-separated lines that any screen (a TUI, a
# GUI, a script) can write and read. The screens stay outside; this is their door.
#
#   book <book.txt> balances   one line per Locus × Measure: Locus, Measure, amount or ?
#   book <book.txt> preview    change lines on stdin (bakhlo's change language)
#                              → OK and the lines the change adds, or REFUSED <code>
#   book <book.txt> save       the same, then saves: SAVED and the lines, or REFUSED <code>
#   book <book.txt> ask        questions on stdin (PACE, PAST, ACTIVITY with POOL lines,
#                              as bakhlo's samples write them) → each with its answer
#
# Amounts are integers in the Measure's smallest unit. Exit status: 0 done, 1 refused.
store ← •Import "../src/store.bqn"
change ← •Import "../src/change.bqn"
balance ← •Import "../src/balance.bqn"
pace ← •Import "../src/pace.bqn"
tab ← @+9
Row ← {1↓∾(tab∾⊢)¨𝕩}
Int ← {𝕩<0 ? "-"∾𝕊-𝕩 ; 𝕩<10 ? ⋈'0'+𝕩 ; (𝕊⌊𝕩÷10)∾'0'+10|𝕩}
Out ← {•Out¨𝕩 ⋄ •Exit 0}
Refused ← {•Out "REFUSED"∾tab∾𝕩.code ⋄ •Exit 1}
# lines the new text has and the old one has not: a change only inserts, so each
# line's occurrence count tells an added copy from an old one
Added ← {new 𝕊 old: (¬(new⋈¨⊒new)∊old⋈¨⊒old)/new}

path‿command ← •args
loaded ← store.Load •wdpath •file.At path
Refused⍟(¬loaded.ok) loaded

Balances ← {𝕊:
  b ← loaded.book
  asked ← ⥊b.locus.id ⋈⌜ b.measure.id
  Out asked {Row 𝕨∾⟨(@≡𝕩)◶⟨Int,"?"˙⟩ 𝕩⟩}¨ b balance.Balances asked
}
Changed ← {𝕊: c ← loaded change.Apply •FLines "/dev/stdin" ⋄ Refused⍟(¬c.ok) c}
Preview ← {𝕊: Out ⟨"OK"⟩ ∾ (Changed @).lines Added loaded.lines}
Save ← {𝕊: s ← loaded store.Save Changed @ ⋄ Refused⍟(¬s.ok) s ⋄ Out ⟨"SAVED"⟩ ∾ s.lines Added loaded.lines}
Ask ← {𝕊:
  lines ← •FLines "/dev/stdin"
  heads ← ({(⊑𝕩⊐tab)↑𝕩}¨lines)∊"PACE"‿"PAST"‿"ACTIVITY"     # each question starts a group
  Out ∾ (loaded.book pace.Ask ⊢)¨ (¯1++`heads)⊔lines
}
Usage ← {𝕊: •Out "usage: book <book.txt> balances|preview|save|ask" ⋄ •Exit 2}
(⊑"balances"‿"preview"‿"save"‿"ask"⊐<command)◶⟨Balances, Preview, Save, Ask, Usage⟩ @
